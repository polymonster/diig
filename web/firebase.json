{
  "hosting": {
    "public": ".output/public",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "rewrites": [
      { "source": "/api/register", "function": { "functionId": "register", "region": "europe-west1" } },
      { "source": "/api/audio-proxy", "function": { "functionId": "audio_proxy", "region": "europe-west1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"]
    }
  ]
}
